import /tee.rc
import /trustonic.rc

on init
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    # A recovery ramdisk has no boot build.prop, but Trustonic requires this
    # value when validating and upgrading metadata-encryption keyblobs.
    setprop ro.bootimage.build.version.security_patch 2024-11-05
    setprop log.tag.vold V
    setprop log.tag.fs_mgr V
    setprop log.tag.libfscrypt V
    setprop log.tag.Keymaster V
    setprop log.tag.keystore2 V
    setprop log.tag.fscrypt V
    setprop log.tag.StorageManagerService V
    setprop log.tag.GateKeeper V
    setprop log.tag.TWRP V

on fs
    install_keyring
    # Recovery skips Android first-stage mounts. Mount persist before starting
    # Trustonic so its secure store never falls back to rootfs tmpfs.
    wait /dev/block/by-name/persist 5
    mount ext4 /dev/block/by-name/persist /persist noatime nosuid nodev
    mkdir /persist/mcRegistry 0771 system system
    start mobicore
    start vendor.keymaster-4-1-trustonic
    start vendor.gatekeeper-1-0

    # mcDriverDaemon registers Keymaster before its RPMB listener is ready.
    # Keep recovery's mount/decrypt path behind Trustonic initialization.
    exec -- /system/bin/sleep 5

on early-init
    # Keep the recovery console useful when debugging early FBE failures.
    write /proc/sys/kernel/printk 8 8 8 8

service vendor.keymaster-4-1-trustonic /vendor/bin/hw/android.hardware.keymaster@4.1-service.trustonic
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    interface android.hardware.keymaster@4.1::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:sys.usb.config=adb
    start adbd

on property:ro.crypto.state=unsupported
    stop mobicore
    stop vendor.keymaster-4-1-trustonic
    stop vendor.gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop vendor.keymaster-4-1-trustonic
    stop vendor.gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:twrp.decrypt.done=true
    stop mobicore
    stop vendor.keymaster-4-1-trustonic
    stop vendor.gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:sys.usb.config=fastboot
    start servicemanager
    start hwservicemanager
    restart fastbootd
    
on boot
    start health-hal-2-1
    setprop sys.usb.config adb
