# Main Partitions
system /system ext4 ro wait,,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system /system erofs ro wait,,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor /vendor ext4 ro wait,,avb,logical,first_stage_mount
vendor /vendor erofs ro wait,,avb,logical,first_stage_mount
product /product ext4 ro wait,,avb,logical,first_stage_mount
product /product erofs ro wait,,avb,logical,first_stage_mount
system_ext /system_ext ext4 ro wait,,avb,logical,first_stage_mount,nofail
system_ext /system_ext erofs ro wait,,avb,logical,first_stage_mount,nofail
odm /odm ext4 ro wait,logical,first_stage_mount,nofail
odm /odm erofs ro wait,logical,first_stage_mount,nofail

# OPLUS Partitions
my_product /my_product ext4 ro wait,logical,first_stage_mount,nofail
my_product /my_product erofs ro wait,logical,first_stage_mount,nofail
my_engineering /my_engineering ext4 ro wait,logical,first_stage_mount,nofail
my_engineering /my_engineering erofs ro wait,logical,first_stage_mount,nofail
my_company /my_company ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_company /my_company erofs ro wait,logical,first_stage_mount,nofail
my_carrier /my_carrier ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_carrier /my_carrier erofs ro wait,logical,first_stage_mount,nofail
my_region /my_region ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_region /my_region erofs ro wait,logical,first_stage_mount,nofail
my_heytap /my_heytap ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_heytap /my_heytap erofs ro wait,logical,first_stage_mount,nofail
my_stock /my_stock ext4 ro,barrier=1 wait,logical,first_stage_mount,nofail
my_stock /my_stock erofs ro wait,logical,first_stage_mount,nofail
my_preload /my_preload ext4 ro wait,logical,first_stage_mount,nofail
my_preload /my_preload erofs ro wait,logical,first_stage_mount,nofail

# Misc
/dev/block/by-name/cdt_engineering /cdt_engineering emmc defaults defaults
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults first_stage_mount,nofail,
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults first_stage_mount,nofail,
/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,fsverity
/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable,nofail
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable,nofail
/dev/block/by-name/nvdata /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable,nofail
/dev/block/by-name/nvcfg /mnt/vendor/nvcfg ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable,nofail
/dev/block/by-name/persist /persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,nofail
/devices/platform/externdevice* auto auto defaults voldmanaged=sdcard1:auto
/devices/platform/11240000.mmc* auto auto defaults voldmanaged=sdcard1:auto
/devices/platform/usb_xhci* auto vfat defaults voldmanaged=usbotg:auto
/devices/platform/soc/11201000.usb0/11200000.xhci* auto vfat defaults voldmanaged=usbotg:auto
/devices/platform/usb0/11200000.xhci* auto vfat defaults voldmanaged=usbotg:auto
/dev/block/by-name/frp /persistent emmc defaults defaults
/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults
/dev/block/by-name/para /para emmc defaults defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
/dev/block/by-name/logo /logo emmc defaults defaults
/dev/block/by-name/boot_para /boot_para emmc defaults defaults
/dev/block/by-name/dtbo /dtbo emmc defaults defaults
#/dev/block/by-name/odm /custom ext4 ro wait,verify,recoveryonly
/dev/block/by-name/vbmeta /vbmeta emmc defaults defaults
/dev/block/by-name/reserve2            /reserve2       emmc    defaults                                                      defaults
#/dev/block/by-name/opporeserve2                            /opporeserve    ext4    rw,seclabel,nosuid,nodev,noatime,data=ordered                 wait
/dev/block/by-name/md_udc /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount
